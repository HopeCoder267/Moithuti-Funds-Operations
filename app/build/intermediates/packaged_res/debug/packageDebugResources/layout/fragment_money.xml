<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Money Management"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <!-- Tab layout for Investors and Loans -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/money_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Investors" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Issue Loan" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Content container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TODO: Add investor list and loan form in Phase 7 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Investor management and loan funding will be added in Phase 7"
            android:gravity="center"
            android:layout_marginTop="100dp"
            android:textColor="@android:color/darker_gray" />

    </FrameLayout>

</LinearLayout>
